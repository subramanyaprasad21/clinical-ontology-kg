PREFIX kg: <https://example.org/clinical-kg/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
SELECT ?assertion WHERE {
 GRAPH <https://example.org/clinical-kg/graph/provenance> {
  ?assertion a kg:ImportedAssertion .
  FILTER NOT EXISTS { ?assertion prov:wasDerivedFrom/prov:wasDerivedFrom/kg:version ?version }
 }
} ORDER BY ?assertion

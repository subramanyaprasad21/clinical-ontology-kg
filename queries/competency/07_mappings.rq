PREFIX kg: <https://example.org/clinical-kg/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
SELECT ?subject ?mappingType ?object ?status WHERE {
 { GRAPH <https://example.org/clinical-kg/graph/provenance> {
   ?a a kg:MappingAssertion ; rdf:subject ?subject ; rdf:predicate ?mappingType ; rdf:object ?object .
 } BIND("source-asserted" AS ?status) }
 UNION { GRAPH <https://example.org/clinical-kg/graph/provenance> {
   ?a a kg:MappingCandidate ; kg:candidateIdentifier ?object ; kg:status ?status .
 } BIND(obo:MONDO_0005148 AS ?subject) }
} ORDER BY ?status ?object

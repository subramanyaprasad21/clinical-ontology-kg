.DS_Store
__pycache__/
*.pyc
.venv/
venv/
.env
.ipynb_checkpoints/

# Keep raw data outside Git unless licensing and size explicitly permit it.
data/raw/**/*
!data/raw/**/.gitkeep

# Generated outputs
reports/figures/*
reports/tables/*
data/interim/*
data/processed/*

# Local tooling and execution logs
.pytest_cache/
reports/environment.json
reports/tests.txt
reports/tests.xml
reports/credibility_audit/baseline/
reports/credibility_audit/*.log

# Detailed audit payloads retain source records locally.
reports/credibility_audit/source_trace.json
reports/credibility_audit/provenance_checks.json
reports/credibility_audit/query_checks.json
reports/credibility_audit/raw_schemas.json
reports/credibility_audit/inference_chains.json
reports/credibility_audit/shacl_checks.json
